<!-- =============================================================================
     Wazuh Local Rules — Spring AttackLogger result_type 기반 탐지 룰
     =============================================================================
     Rule ID 범위 (로컬 룰: 100000 이상 권장)
       100001        : ATTACK_REQUEST 수신 (기본 로깅)
       100002        : ATTACK_RESPONSE 수신 (기본 로깅)
       100010–100019 : Brute Force (T1110) — 100010~100015 deprecated: replaced by JSON rules 100230~100233 (level 0)
       100020–100029 : Path Traversal (T1083) — 100020~100022 deprecated: replaced by JSON rule 100220 (level 0)
       100030–100039 : SQL Injection (T1190) — 100030~100034 deprecated: replaced by JSON rule 100210 (level 0)
       100040–100049 : 피드백 개선 룰 (Phase 2)
       100050–100059 : Kill Chain 상관관계 (Phase 2)
       100060–100069 : XSS (T1059.007) — AttackLogger
       100070–100079 : SSRF (T1090) — AttackLogger
       100080–100089 : RCE/Command Injection (T1059.004) — AttackLogger
       100200        : OCSF HTTP Activity JSON 수신 base (attack.json.log, 커스텀 디코더 없음)
       100210–100219 : SQL Injection (T1190) — OCSF JSON
       100220–100229 : Path Traversal (T1190) — OCSF JSON
       100230–100239 : Brute Force (T1110) — OCSF JSON
       100240–100249 : SSRF (T1190) — OCSF JSON

     디코더 action 필드 = result_type 값:
       AUTH_FAIL, AUTH_SUCCESS
       FILE_RETURNED
       SQL_ERROR_EXPOSED, UNION_DATA_LEAKED
       NOT_FOUND, DB_ERROR, ERROR, NORMAL
     ============================================================================= -->

<group name="vuln-webapp,attack-logger,">

    <!-- ─────────────────────────────────────────────────────────────────── -->
    <!-- 기본 수신 룰 (상위 룰 — 모든 하위 룰의 부모)                       -->
    <!-- ─────────────────────────────────────────────────────────────────── -->

    <rule id="100001" level="3">
        <decoded_as>vuln-attack-request</decoded_as>
        <description>AttackLogger: ATTACK_REQUEST received</description>
        <group>attack_request,</group>
    </rule>

    <rule id="100002" level="3">
        <decoded_as>vuln-attack-response</decoded_as>
        <description>AttackLogger: ATTACK_RESPONSE received</description>
        <group>attack_response,</group>
    </rule>


    <!-- ─────────────────────────────────────────────────────────────────── -->
    <!-- Brute Force — T1110                                                -->
    <!-- ─────────────────────────────────────────────────────────────────── -->

    <!-- 로그인 실패 단건 -->
    <!-- deprecated: replaced by JSON rules 100230~100233 (원래 level 6) -->
    <rule id="100010" level="0">
        <if_sid>100002</if_sid>
        <field name="result_type">AUTH_FAIL</field>
        <description>Brute Force: Login attempt failed (T1110)</description>
        <mitre>
            <id>T1110</id>
        </mitre>
        <group>brute_force,authentication_failed,</group>
    </rule>

    <!-- 로그인 실패 반복 탐지 (2분 내 10회 이상) -->
    <!-- deprecated: replaced by JSON rules 100230~100233 (원래 level 12) -->
    <rule id="100011" level="0" frequency="10" timeframe="120">
        <if_matched_sid>100010</if_matched_sid>
        <same_source_ip/>
        <description>Brute Force: Multiple login failures detected from same IP (T1110)</description>
        <mitre>
            <id>T1110</id>
        </mitre>
        <group>brute_force,pci_dss_11.4,gdpr_IV_35.7.d,</group>
    </rule>

    <!-- 로그인 성공 (Brute Force 성공 가능성) -->
    <!-- deprecated: replaced by JSON rules 100230~100233 (원래 level 10) -->
    <rule id="100012" level="0">
        <if_sid>100002</if_sid>
        <field name="result_type">AUTH_SUCCESS</field>
        <description>Brute Force: Login succeeded - possible credential compromise (T1110)</description>
        <mitre>
            <id>T1110</id>
        </mitre>
        <group>brute_force,authentication_success,</group>
    </rule>


    <!-- ─────────────────────────────────────────────────────────────────── -->
    <!-- Path Traversal — T1083                                             -->
    <!-- ─────────────────────────────────────────────────────────────────── -->

    <!-- 파일 접근 성공 (Tier 1 & 2 공통)
         주의: url은 Wazuh 정적 필드이므로 <field name>이 아닌 <url> 디렉티브 사용 -->
    <!-- deprecated: replaced by JSON rule 100220 (원래 level 12) -->
    <rule id="100020" level="0">
        <if_sid>100002</if_sid>
        <field name="result_type">FILE_RETURNED</field>
        <url>/api/files/download</url>
        <description>Path Traversal: Sensitive file returned via download endpoint (T1083)</description>
        <mitre>
            <id>T1083</id>
        </mitre>
        <group>path_traversal,file_access,</group>
    </rule>

    <!-- 파일 미발견 (탐색 시도 — 낮은 레벨로 기록) -->
    <!-- deprecated: replaced by JSON rule 100220 (원래 level 5) -->
    <rule id="100021" level="0">
        <if_sid>100002</if_sid>
        <field name="result_type">NOT_FOUND</field>
        <url>/api/files/download</url>
        <description>Path Traversal: File not found via download endpoint - traversal probe (T1083)</description>
        <mitre>
            <id>T1083</id>
        </mitre>
        <group>path_traversal,file_probe,</group>
    </rule>

    <!-- 파일 접근 권한 거부 (ERROR) — /etc/shadow 등 권한 보호 파일 접근 시도
         result_type=ERROR + download 엔드포인트 조합으로 PT 시도를 탐지.
         FILE_RETURNED보다 낮지만 NOT_FOUND보다 높은 level 8 부여 -->
    <!-- deprecated: replaced by JSON rule 100220 (원래 level 8) -->
    <rule id="100022" level="0">
        <if_sid>100002</if_sid>
        <field name="result_type">ERROR</field>
        <url>/api/files/download</url>
        <description>Path Traversal: Permission denied or error on file access attempt (T1083)</description>
        <mitre>
            <id>T1083</id>
        </mitre>
        <group>path_traversal,file_access_denied,</group>
    </rule>


    <!-- ─────────────────────────────────────────────────────────────────── -->
    <!-- SQL Injection — T1190                                              -->
    <!-- ─────────────────────────────────────────────────────────────────── -->

    <!-- Step 1: SQL 에러 유발 성공 (sqli_error_probe) -->
    <!-- deprecated: replaced by JSON rule 100210 (원래 level 10) -->
    <rule id="100030" level="0">
        <if_sid>100002</if_sid>
        <field name="result_type">SQL_ERROR_EXPOSED</field>
        <description>SQLi: SQL error message exposed - error-based probe succeeded (T1190)</description>
        <mitre>
            <id>T1190</id>
        </mitre>
        <group>sql_injection,sqli_probe,</group>
    </rule>

    <!-- Step 3: UNION SELECT 데이터 유출 성공 (sqli_union_extract) -->
    <!-- deprecated: replaced by JSON rule 100210 (원래 level 15) -->
    <rule id="100031" level="0">
        <if_sid>100002</if_sid>
        <field name="result_type">UNION_DATA_LEAKED</field>
        <description>SQLi: UNION SELECT data extraction succeeded - credential data leaked (T1190)</description>
        <mitre>
            <id>T1190</id>
        </mitre>
        <group>sql_injection,data_exfiltration,pci_dss_6.5.1,</group>
    </rule>

    <!-- 응답 크기 이상 탐지 (LENGTH_ANOMALY — UNION 등 대량 데이터 유출 가능성) -->
    <!-- deprecated: replaced by JSON rule 100210 (원래 level 10) -->
    <rule id="100032" level="0">
        <if_sid>100002</if_sid>
        <field name="result_type">LENGTH_ANOMALY</field>
        <description>SQLi: Response length anomaly detected - possible data exfiltration (T1190)</description>
        <mitre>
            <id>T1190</id>
        </mitre>
        <group>sql_injection,length_anomaly,</group>
    </rule>

    <!-- 응답 지연 탐지 (TIME_BASED_DELAY — pg_sleep 등 Blind SQLi)
         호스트 기반 탐지 우위 케이스 — Suricata는 패턴 매칭이 어려움 -->
    <!-- deprecated: replaced by JSON rule 100210 (원래 level 12) -->
    <rule id="100033" level="0">
        <if_sid>100002</if_sid>
        <field name="result_type">TIME_BASED_DELAY</field>
        <description>SQLi: Response delay detected - time-based blind SQLi succeeded (T1190)</description>
        <mitre>
            <id>T1190</id>
        </mitre>
        <group>sql_injection,blind_sqli,time_based,</group>
    </rule>


    <!-- ─────────────────────────────────────────────────────────────────── -->
    <!-- 피드백 개선 룰 (Phase 2) — AUTH_SUCCESS FP 해소 + 신규 탐지        -->
    <!-- ─────────────────────────────────────────────────────────────────── -->

    <!-- AUTH_SUCCESS 시퀀스 룰: AUTH_FAIL 5회 이상 후 AUTH_SUCCESS 발생 시
         level 15로 상향 — 실제 Brute Force 성공 징후 -->
    <!-- deprecated: replaced by JSON rules 100230~100233 (원래 level 15) -->
    <rule id="100013" level="0">
        <if_matched_sid>100010</if_matched_sid>
        <same_source_ip/>
        <field name="result_type">AUTH_SUCCESS</field>
        <description>Brute Force: Login succeeded after multiple failures - credential compromise confirmed (T1110)</description>
        <mitre>
            <id>T1110</id>
        </mitre>
        <group>brute_force,credential_compromise,pci_dss_10.2.4,</group>
    </rule>

    <!-- 저속 Brute Force 탐지 (5분 내 5회 실패) — Slow & Low 대응 -->
    <!-- deprecated: replaced by JSON rules 100230~100233 (원래 level 10) -->
    <rule id="100014" level="0" frequency="5" timeframe="300">
        <if_matched_sid>100010</if_matched_sid>
        <same_source_ip/>
        <description>Brute Force: Slow login failures detected (5/300s) - possible slow brute force (T1110)</description>
        <mitre>
            <id>T1110</id>
        </mitre>
        <group>brute_force,slow_attack,</group>
    </rule>

    <!-- Password Spraying 탐지 (같은 IP에서 다른 사용자로 반복 실패) -->
    <!-- deprecated: replaced by JSON rules 100230~100233 (원래 level 12) -->
    <rule id="100015" level="0" frequency="5" timeframe="120">
        <if_matched_sid>100010</if_matched_sid>
        <same_source_ip/>
        <different_user/>
        <description>Brute Force: Password spraying detected - multiple users from same IP (T1110.003)</description>
        <mitre>
            <id>T1110.003</id>
        </mitre>
        <group>brute_force,password_spraying,</group>
    </rule>

    <!-- Kill Chain 상관관계: UNION 데이터 유출 후 인증 시도 -->
    <rule id="100050" level="15">
        <if_matched_sid>100031</if_matched_sid>
        <same_source_ip/>
        <field name="result_type">AUTH_SUCCESS</field>
        <description>Kill Chain: Login succeeded after SQLi data extraction - attack chain detected (T1190+T1078)</description>
        <mitre>
            <id>T1078</id>
        </mitre>
        <group>kill_chain,credential_compromise,</group>
    </rule>

    <!-- Kill Chain 상관관계: 인증 성공 후 파일 접근 -->
    <rule id="100051" level="15">
        <if_matched_sid>100012</if_matched_sid>
        <same_source_ip/>
        <field name="result_type">FILE_RETURNED</field>
        <description>Kill Chain: File access after login - possible post-compromise data theft (T1078+T1083)</description>
        <mitre>
            <id>T1083</id>
        </mitre>
        <group>kill_chain,post_compromise,data_theft,</group>
    </rule>

    <!-- DB 에러 탐지 (일반) -->
    <!-- deprecated: replaced by JSON rule 100210 (원래 level 8) -->
    <rule id="100034" level="0">
        <if_sid>100002</if_sid>
        <field name="result_type">DB_ERROR</field>
        <description>SQLi: Database error detected - possible injection attempt (T1190)</description>
        <mitre>
            <id>T1190</id>
        </mitre>
        <group>sql_injection,db_error,</group>
    </rule>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- OWASP 확장: XSS (T1059.007) — AttackLogger 기반                    -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <!-- XSS 공격 요청 탐지 — URL에 script/onerror/javascript 패턴 -->
    <rule id="100060" level="10">
        <if_sid>100001</if_sid>
        <url>script|onerror|onload|ontoggle|javascript:</url>
        <description>XSS: Script/event handler pattern detected in request URL (T1059.007)</description>
        <mitre>
            <id>T1059.007</id>
        </mitre>
        <group>xss,injection,</group>
    </rule>

    <!-- XSS 성공 탐지 — 응답에 XSS_REFLECTED 또는 XSS_STORED -->
    <rule id="100061" level="12">
        <if_sid>100002</if_sid>
        <field name="result_type">XSS_REFLECTED|XSS_STORED</field>
        <description>XSS: Reflected/Stored XSS confirmed by server response (T1059.007)</description>
        <mitre>
            <id>T1059.007</id>
        </mitre>
        <group>xss,injection,attack_confirmed,</group>
    </rule>

    <!-- XSS 우회 시도 — 인코딩/난독화 패턴 -->
    <rule id="100062" level="10">
        <if_sid>100001</if_sid>
        <url>%3Cscript|%3cscript|&#60;|&#x3c;</url>
        <description>XSS: URL-encoded/HTML-entity script tag evasion attempt (T1059.007)</description>
        <mitre>
            <id>T1059.007</id>
        </mitre>
        <group>xss,evasion,</group>
    </rule>

    <!-- XSS — document.cookie 탈취 패턴 -->
    <rule id="100063" level="12">
        <if_sid>100001</if_sid>
        <url>document.cookie|document.domain</url>
        <description>XSS: Cookie/domain exfiltration pattern detected (T1059.007)</description>
        <mitre>
            <id>T1059.007</id>
        </mitre>
        <group>xss,data_exfiltration,</group>
    </rule>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- OWASP 확장: SSRF (T1090) — AttackLogger 기반                       -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <!-- SSRF parent — /api/preview 엔드포인트 진입점 (level 0, 자체 발동 안 함)
         하위 룰 100070/100072가 if_sid로 chaining하여 /api/preview 한정 매칭을 보장.
         Phase 3 테스트에서 발견: <url> 반복은 OR 동작이므로 단일 룰에서 엔드포인트+패턴
         AND를 표현할 수 없음. parent-child 구조로 강제. -->
    <rule id="100069" level="0">
        <if_sid>100001</if_sid>
        <url>/api/preview</url>
        <description>SSRF parent: /api/preview endpoint requested (T1090)</description>
        <group>ssrf,endpoint_probe,</group>
    </rule>

    <!-- SSRF 기본 — 내부 IP / 메타데이터 접근 시도 -->
    <rule id="100070" level="12">
        <if_sid>100069</if_sid>
        <url>169.254.169.254|127.0.0.1|localhost|metadata.google.internal</url>
        <description>SSRF: Internal/metadata endpoint access attempt via /api/preview (T1090)</description>
        <mitre>
            <id>T1090</id>
        </mitre>
        <group>ssrf,internal_access,</group>
    </rule>

    <!-- SSRF 성공 탐지 — 응답에 SSRF_SUCCESS -->
    <rule id="100071" level="14">
        <if_sid>100002</if_sid>
        <field name="result_type">SSRF_SUCCESS|SSRF_DATA_LEAKED</field>
        <description>SSRF: Server-side request succeeded — internal data exposed (T1090)</description>
        <mitre>
            <id>T1090</id>
        </mitre>
        <group>ssrf,attack_confirmed,data_exfiltration,</group>
    </rule>

    <!-- SSRF 우회 — IP 인코딩 변환 (0x7f, 2130706433, [::1] 등). 100069 chaining으로 /api/preview 한정. -->
    <rule id="100072" level="12">
        <if_sid>100069</if_sid>
        <url>0x7f|2130706433|%5B%3A%3A1%5D|0177.0|::ffff:</url>
        <description>SSRF: IP encoding bypass attempt (hex/decimal/IPv6) via /api/preview (T1090)</description>
        <mitre>
            <id>T1090</id>
        </mitre>
        <group>ssrf,evasion,</group>
    </rule>

    <!-- SSRF 포트 스캔 패턴 — 다수 내부 포트 접근 시도
         frequency/timeframe 기반 룰은 if_matched_sid를 요구 -->
    <rule id="100073" level="10" frequency="5" timeframe="30">
        <if_matched_sid>100070</if_matched_sid>
        <same_source_ip/>
        <description>SSRF: Multiple internal port scan attempts (5/30s) (T1046)</description>
        <mitre>
            <id>T1046</id>
        </mitre>
        <group>ssrf,port_scan,</group>
    </rule>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- OWASP 확장: RCE / Command Injection (T1059.004) — AttackLogger 기반 -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <!-- CMDi parent — /api/admin/ping 엔드포인트 진입점 (level 0)
         하위 룰들이 if_sid로 chaining하여 /api/admin/ping 한정 매칭을 강제. -->
    <rule id="100079" level="0">
        <if_sid>100001</if_sid>
        <url>/api/admin/ping</url>
        <description>CMDi parent: /api/admin/ping endpoint requested (T1059.004)</description>
        <group>command_injection,endpoint_probe,</group>
    </rule>

    <!-- CMDi 기본 (인코딩 메타문자) — URL-encoded shell metachar -->
    <rule id="100080" level="12">
        <if_sid>100079</if_sid>
        <url>%3B|%7C|%26%26|%60|%24%28</url>
        <description>CMDi: Shell metacharacter (encoded) detected in ping endpoint (T1059.004)</description>
        <mitre>
            <id>T1059.004</id>
        </mitre>
        <group>command_injection,rce,</group>
    </rule>

    <!-- CMDi 기본 (디코딩 메타문자) — Phase 3에서 추가
         디코더 url 필드는 URL-디코딩되므로 raw 로그 라인의 params=host=... 부분을
         pcre2로 매칭한다. host 값 끝/중간에 ;, $(, `, ||, &&가 붙는 경우만 발동.
         일반 호스트(8.8.8.8, example.com)는 매칭하지 않음. -->
    <rule id="100085" level="12">
        <if_sid>100079</if_sid>
        <regex type="pcre2">params=host=[^\s|]*(?:;|\$\(|`|\|\||&amp;&amp;)</regex>
        <description>CMDi: Shell metacharacter (decoded) detected in ping endpoint (T1059.004)</description>
        <mitre>
            <id>T1059.004</id>
        </mitre>
        <group>command_injection,rce,</group>
    </rule>

    <!-- CMDi 성공 — RCE 확인 -->
    <rule id="100081" level="15">
        <if_sid>100002</if_sid>
        <field name="result_type">RCE_CONFIRMED|COMMAND_EXECUTED</field>
        <description>CMDi: Remote command execution confirmed (T1059.004)</description>
        <mitre>
            <id>T1059.004</id>
        </mitre>
        <group>command_injection,rce,attack_confirmed,</group>
    </rule>

    <!-- CMDi Blind — sleep/ping 지연 명령. 100079 chain으로 /api/admin/ping 한정. -->
    <rule id="100082" level="12">
        <if_sid>100079</if_sid>
        <url>sleep|ping+-c</url>
        <description>CMDi: Blind command injection (sleep/ping delay) detected (T1059.004)</description>
        <mitre>
            <id>T1059.004</id>
        </mitre>
        <group>command_injection,blind_cmdi,</group>
    </rule>

    <!-- CMDi 우회 — $IFS, hex 인코딩, base64 디코딩. 100079 chain으로 /api/admin/ping 한정. -->
    <rule id="100083" level="12">
        <if_sid>100079</if_sid>
        <url>${IFS}|%0a|base64+-d|printf</url>
        <description>CMDi: Filter evasion technique detected (IFS/newline/encoding) (T1059.004)</description>
        <mitre>
            <id>T1059.004</id>
        </mitre>
        <group>command_injection,evasion,</group>
    </rule>

    <!-- CMDi 시스템 파일 읽기 — /etc/passwd, whoami, id -->
    <rule id="100084" level="14">
        <if_sid>100080</if_sid>
        <url>etc%2Fpasswd|etc%2Fshadow|whoami</url>
        <description>CMDi: System file read / identity command via injection (T1059.004)</description>
        <mitre>
            <id>T1059.004</id>
        </mitre>
        <group>command_injection,rce,sensitive_data,</group>
    </rule>

</group>


<!-- =============================================================================
     SQL Injection / Path Traversal (T1190) / Brute Force (T1110) — OCSF HTTP Activity JSON 기반
     =============================================================================
     입력: /var/log/target/attack.json.log (agent localfile log_format=json, 기본 JSON 디코더)
     원칙: http_request.* / http_response.* 만 참조한다. validation.* / correlation.* 는 앱 측
           자체 관찰값이므로 탐지 조건에 쓰지 않는다.
     원본: detections/sigma/sqli_product_search.yml   (100210은 이를 수동 변환한 배포본)
           detections/sigma/path_traversal_download.yml (100220은 이를 수동 변환한 배포본)
           detections/sigma/brute_force_login.yml       (100230~100233은 이를 수동 변환한 배포본)
     ============================================================================= -->

<group name="vuln-webapp,attack-http-activity,">

    <!-- Base: OCSF HTTP Activity JSON 수신 (level 0, 자체 발동 안 함) -->
    <rule id="100200" level="0">
        <field name="metadata.log_name">attack_http_activity</field>
        <description>AttackLogger: OCSF HTTP Activity JSON received</description>
        <group>attack_http_activity,</group>
    </rule>

    <!-- 요청 신호: product search 요청 인자에 SQLi 패턴 -->
    <rule id="100210" level="10">
        <if_sid>100200</if_sid>
        <field name="http_request.url.path">/api/products/search</field>
        <field name="http_request.args" type="pcre2">(?i)(union\s+select|pg_sleep|'\s*or\s*1=1|'[^']*--|information_schema)</field>
        <description>SQLi: injection pattern in product search request (JSON, request-signal)</description>
        <mitre>
            <id>T1190</id>
        </mitre>
        <group>sql_injection,request_signal,</group>
    </rule>

    <!-- 요청 신호 확장(S5 Gap #7): product search 요청 인자에 SQL 주입 구문 신호.
         100210(좁은 정규식)이 못 잡는 단일 작은따옴표 등 주입 행위를 request-signal 로 잡는다. 100210 은 보존.
         http_request.* 만 본다(B안). args 는 URL 디코딩 값(Spring @RequestParam, attack.json.log http_request.args, A2 실측 keyword=').
         신호: 따옴표(' ") / 문장구분(;) / UNION SELECT / information_schema / 시간지연 함수(sleep·pg_sleep·benchmark·waitfor delay).
         SQL 주석·불린 주입은 keyword LIKE 문맥상 따옴표로 문자열을 깨야 주입되므로 따옴표 신호로 커버 — bare 주석 토큰은
         넣지 않는다(정상어 laptop 하이픈 하이픈 pro 오탐 방지). lookbehind 는 XML 부등호 이스케이프가 Wazuh PCRE2 로드 실패를 일으켜 쓰지 않는다. -->
    <rule id="100211" level="10">
        <if_sid>100200</if_sid>
        <field name="http_request.url.path">/api/products/search</field>
        <field name="http_request.args" type="pcre2">(?i)('|"|;|\bunion\s+select\b|\binformation_schema\b|\b(?:sleep|pg_sleep|benchmark)\s*\(|\bwaitfor\s+delay\b)</field>
        <description>SQLi: injection syntax signal in product search request (JSON, request-signal, DET0080 request content) - S5 Gap #7</description>
        <mitre>
            <id>T1190</id>
        </mitre>
        <group>sql_injection,request_signal,</group>
    </rule>

    <!-- 요청 신호: file download 요청 인자에 Path Traversal 패턴 -->
    <rule id="100220" level="12">
        <if_sid>100200</if_sid>
        <field name="http_request.url.path">/api/files/download</field>
        <field name="http_request.args" type="pcre2">(?i)(\.\./|\.\.%2f|%2e%2e|/etc/passwd|/etc/shadow|\.\.\\)</field>
        <description>Path Traversal: traversal pattern in download request (JSON, request-signal)</description>
        <mitre>
            <id>T1190</id>
        </mitre>
        <group>path_traversal,request_signal,</group>
    </rule>

    <!-- 응답 신호: login 실패 (401) 단건
         http_response.code 는 JSON 숫자지만 Wazuh JSON 디코더가 문자열로 저장하므로 ^...$ 로 고정 -->
    <rule id="100230" level="5">
        <if_sid>100200</if_sid>
        <field name="http_request.url.path">/api/auth/login</field>
        <field name="http_response.code">^401$</field>
        <description>BF: login failed (T1110)</description>
        <mitre>
            <id>T1110</id>
        </mitre>
        <group>brute_force,authentication_failed,</group>
    </rule>

    <!-- 같은 계정에서 2분 내 로그인 실패 반복
         JSON 로그의 http_request.args(username=<계정>)를 same_field 로 사용해 계정별 실패를 상관한다 -->
    <rule id="100231" level="12" frequency="10" timeframe="120">
        <if_matched_sid>100230</if_matched_sid>
        <same_field>http_request.args</same_field>
        <description>BF: multiple login failures for same account (T1110)</description>
        <mitre>
            <id>T1110</id>
        </mitre>
        <group>brute_force,pci_dss_11.4,gdpr_IV_35.7.d,</group>
    </rule>

    <!-- 응답 신호: login 성공 (200) 단건 -->
    <rule id="100232" level="12">
        <if_sid>100200</if_sid>
        <field name="http_request.url.path">/api/auth/login</field>
        <field name="http_response.code">^200$</field>
        <description>BF: login success (T1110)</description>
        <mitre>
            <id>T1110</id>
        </mitre>
        <group>brute_force,authentication_success,</group>
    </rule>

    <!-- 같은 계정에서 실패 반복(100231) 뒤 2분 내 성공
         if_sid 100232(현재 이벤트=성공) + if_matched_sid 100231(실패 10회 상관 결과)
         if_matched_sid 100230 + frequency 로는 기준을 맞출 수 없다: 10번째 실패는 100231로 매칭되어
         100230 이력에 남지 않으므로 "실패 9회"와 "실패 10회"가 구분되지 않음 (wazuh-logtest 4.14.4 확인) -->
    <rule id="100233" level="15" timeframe="120">
        <if_sid>100232</if_sid>
        <if_matched_sid>100231</if_matched_sid>
        <same_field>http_request.args</same_field>
        <description>BF: success after repeated failures - credential compromise (T1110)</description>
        <mitre>
            <id>T1110</id>
        </mitre>
        <group>brute_force,credential_compromise,pci_dss_10.2.4,</group>
    </rule>

    <!-- 요청 신호: url preview 요청 인자(url 값)에 내부/메타데이터 대상 패턴 (SSRF)
         B안(관제 독립): http_request.* 만 참조. validation.*(SsrfValidator 정답지)는 조건에 쓰지 않는다.
         pcre2 는 메타데이터 호스트(169.254.169.254 / metadata / /latest/meta-data), loopback/link-local,
         사설 대역(10/172.16-31/192.168), IPv6 loopback(::1) 을 url 값에서 매칭한다.
         example.com 등 외부 공개 호스트는 매칭되지 않아 오탐이 억제된다. -->
    <rule id="100240" level="12">
        <if_sid>100200</if_sid>
        <field name="http_request.url.path">/api/preview</field>
        <field name="http_request.args" type="pcre2">(?i)(169\.254\.169\.254|/latest/meta-?data|metadata|127\.|169\.254\.|10\.|172\.(1[6-9]|2\d|3[01])\.|192\.168\.|::1)</field>
        <description>SSRF: internal/metadata target in url preview request (JSON, request-signal)</description>
        <mitre>
            <id>T1190</id>
        </mitre>
        <group>ssrf,request_signal,</group>
    </rule>

</group>

<!-- =============================================================================
     [DEPRECATED] Nginx access.log 기반 보조 탐지 룰
     =============================================================================
     ⚠ Phase 3 테스트(2026-05-20) 결과 본 그룹의 룰은 절대 발동하지 않음을 확인:
        - Wazuh 기본 디코더 `web-accesslog`가 `192.168.x - - [date]...` 패턴을 선점
        - 본 프로젝트의 `vuln-nginx-access` 디코더는 활성화되지 않음
        - Wazuh 기본 Rule 31106(level 6, "A web attack returned code 200"),
          31108, 31151 등이 동일 역할을 수행 → 탐지 공백 없음

     보존 사유: 향후 디코더 우선순위를 우회(<use_own_name>, 기본 룰 override 등)할 때
                재활용 가능. 즉시 발동시키지는 않지만 코드 형태로 유지.

     === 원본 의도 ===
     AttackLogger 미탑재 환경에서 Nginx access.log만으로 공격 패턴 탐지
     Rule ID 범위: 100100–100174 (Nginx 보조)
     ============================================================================= -->

<group name="vuln-webapp,nginx-access,">

    <!-- ─────────────────────────────────────────────────────────────────── -->
    <!-- 기본 수신 룰 (Nginx access log 부모)                               -->
    <!-- ─────────────────────────────────────────────────────────────────── -->

    <rule id="100100" level="0">
        <decoded_as>vuln-nginx-access</decoded_as>
        <description>Nginx: Access log received</description>
        <group>nginx_access,</group>
    </rule>


    <!-- ─────────────────────────────────────────────────────────────────── -->
    <!-- SQL Injection 패턴 — URI 기반 (T1190)                             -->
    <!-- ─────────────────────────────────────────────────────────────────── -->

    <!-- UNION SELECT 패턴 탐지 -->
    <rule id="100110" level="10">
        <if_sid>100100</if_sid>
        <url>UNION|union</url>
        <url>SELECT|select</url>
        <description>Nginx-SQLi: UNION SELECT pattern detected in URI (T1190)</description>
        <mitre>
            <id>T1190</id>
        </mitre>
        <group>sql_injection,nginx_detect,</group>
    </rule>

    <!-- 싱글쿼트 + SQL 코멘트(--) 조합 -->
    <rule id="100111" level="10">
        <if_sid>100100</if_sid>
        <url>/api/products/search</url>
        <match>%27|'</match>
        <match>--</match>
        <description>Nginx-SQLi: Single quote with SQL comment in search URI (T1190)</description>
        <mitre>
            <id>T1190</id>
        </mitre>
        <group>sql_injection,nginx_detect,</group>
    </rule>

    <!-- pg_sleep 키워드 탐지 -->
    <rule id="100112" level="12">
        <if_sid>100100</if_sid>
        <url>pg_sleep|PG_SLEEP</url>
        <description>Nginx-SQLi: pg_sleep injection detected in URI (T1190)</description>
        <mitre>
            <id>T1190</id>
        </mitre>
        <group>sql_injection,blind_sqli,nginx_detect,</group>
    </rule>

    <!-- HTTP 500 에러 on search endpoint → SQL 에러 가능성 -->
    <rule id="100113" level="8">
        <if_sid>100100</if_sid>
        <url>/api/products/search</url>
        <status>500</status>
        <description>Nginx-SQLi: HTTP 500 on search endpoint - possible SQL error exposed (T1190)</description>
        <mitre>
            <id>T1190</id>
        </mitre>
        <group>sql_injection,server_error,nginx_detect,</group>
    </rule>


    <!-- ─────────────────────────────────────────────────────────────────── -->
    <!-- Path Traversal 패턴 — URI 기반 (T1083)                            -->
    <!-- ─────────────────────────────────────────────────────────────────── -->

    <!-- ../../ 연속 경로 조작 -->
    <rule id="100120" level="10">
        <if_sid>100100</if_sid>
        <url>../../</url>
        <description>Nginx-PT: Directory traversal pattern (../../) in URI (T1083)</description>
        <mitre>
            <id>T1083</id>
        </mitre>
        <group>path_traversal,nginx_detect,</group>
    </rule>

    <!-- URL 인코딩된 traversal (%2e%2e) -->
    <rule id="100121" level="10">
        <if_sid>100100</if_sid>
        <url>%2e%2e|%2E%2E</url>
        <description>Nginx-PT: URL-encoded traversal pattern in URI (T1083)</description>
        <mitre>
            <id>T1083</id>
        </mitre>
        <group>path_traversal,nginx_detect,</group>
    </rule>

    <!-- /etc/passwd 접근 -->
    <rule id="100122" level="12">
        <if_sid>100100</if_sid>
        <url>etc/passwd|etc%2Fpasswd</url>
        <description>Nginx-PT: /etc/passwd access attempt in URI (T1083)</description>
        <mitre>
            <id>T1083</id>
        </mitre>
        <group>path_traversal,sensitive_file,nginx_detect,</group>
    </rule>

    <!-- /etc/shadow 접근 -->
    <rule id="100123" level="12">
        <if_sid>100100</if_sid>
        <url>etc/shadow|etc%2Fshadow</url>
        <description>Nginx-PT: /etc/shadow access attempt in URI (T1083)</description>
        <mitre>
            <id>T1083</id>
        </mitre>
        <group>path_traversal,sensitive_file,nginx_detect,</group>
    </rule>

    <!-- .ssh/id_rsa 접근 -->
    <rule id="100124" level="12">
        <if_sid>100100</if_sid>
        <url>.ssh</url>
        <url>id_rsa</url>
        <description>Nginx-PT: SSH key access attempt in URI (T1083)</description>
        <mitre>
            <id>T1083</id>
        </mitre>
        <group>path_traversal,sensitive_file,nginx_detect,</group>
    </rule>


    <!-- ─────────────────────────────────────────────────────────────────── -->
    <!-- Brute Force 탐지 — 로그인 엔드포인트 + 상태코드 (T1110)           -->
    <!-- ─────────────────────────────────────────────────────────────────── -->

    <!-- 로그인 실패 (401/403) 단건 -->
    <rule id="100130" level="6">
        <if_sid>100100</if_sid>
        <url>/api/auth/login</url>
        <protocol>POST</protocol>
        <status>401|403</status>
        <description>Nginx-BF: Login attempt failed (HTTP 401/403) (T1110)</description>
        <mitre>
            <id>T1110</id>
        </mitre>
        <group>brute_force,authentication_failed,nginx_detect,</group>
    </rule>

    <!-- 로그인 실패 반복 (2분 내 10회) -->
    <rule id="100131" level="12" frequency="10" timeframe="120">
        <if_matched_sid>100130</if_matched_sid>
        <same_source_ip/>
        <description>Nginx-BF: Multiple login failures from same IP (10/120s) (T1110)</description>
        <mitre>
            <id>T1110</id>
        </mitre>
        <group>brute_force,nginx_detect,</group>
    </rule>

    <!-- 저속 Brute Force (5분 내 5회 실패) -->
    <rule id="100132" level="10" frequency="5" timeframe="300">
        <if_matched_sid>100130</if_matched_sid>
        <same_source_ip/>
        <description>Nginx-BF: Slow brute force detected (5/300s) (T1110)</description>
        <mitre>
            <id>T1110</id>
        </mitre>
        <group>brute_force,slow_attack,nginx_detect,</group>
    </rule>

    <!-- 로그인 성공 (200) — 이전에 실패가 있었으면 상관관계 -->
    <rule id="100133" level="10">
        <if_sid>100100</if_sid>
        <url>/api/auth/login</url>
        <protocol>POST</protocol>
        <status>200</status>
        <description>Nginx-BF: Login succeeded (HTTP 200) (T1110)</description>
        <mitre>
            <id>T1110</id>
        </mitre>
        <group>brute_force,authentication_success,nginx_detect,</group>
    </rule>

    <!-- 로그인 실패 후 성공 → credential compromise -->
    <rule id="100134" level="15">
        <if_matched_sid>100130</if_matched_sid>
        <same_source_ip/>
        <protocol>POST</protocol>
        <status>200</status>
        <description>Nginx-BF: Login succeeded after failures - credential compromise (T1110)</description>
        <mitre>
            <id>T1110</id>
        </mitre>
        <group>brute_force,credential_compromise,nginx_detect,</group>
    </rule>


    <!-- ─────────────────────────────────────────────────────────────────── -->
    <!-- HTTP 에러 기반 이상 탐지                                          -->
    <!-- ─────────────────────────────────────────────────────────────────── -->

    <!-- 4xx 에러 단건 (부모) — 100140 빈도 룰의 매칭 대상 -->
    <rule id="100139" level="0">
        <if_sid>100100</if_sid>
        <status>400|403|404|405</status>
        <description>Nginx: HTTP 4xx error response (probe)</description>
        <group>scanning,nginx_detect,</group>
    </rule>

    <!-- 대량 4xx 에러 (스캐닝/프로빙 징후) -->
    <rule id="100140" level="8" frequency="20" timeframe="60">
        <if_matched_sid>100139</if_matched_sid>
        <same_source_ip/>
        <description>Nginx: Excessive HTTP 4xx errors from same IP (20/60s) - possible scanning</description>
        <group>scanning,nginx_detect,</group>
    </rule>

    <!-- 5xx 에러 단건 (부모) — 100141 빈도 룰의 매칭 대상 -->
    <rule id="100138" level="0">
        <if_sid>100100</if_sid>
        <status>500|502|503</status>
        <description>Nginx: HTTP 5xx error response</description>
        <group>server_error,nginx_detect,</group>
    </rule>

    <!-- 대량 5xx 에러 (공격으로 인한 서버 불안정) -->
    <rule id="100141" level="10" frequency="5" timeframe="60">
        <if_matched_sid>100138</if_matched_sid>
        <description>Nginx: Multiple HTTP 5xx errors (5/60s) - possible attack-induced instability</description>
        <group>server_error,nginx_detect,</group>
    </rule>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- Nginx 보조: XSS 탐지 (100150–100159)                              -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <!-- XSS — URI에 script 태그 -->
    <rule id="100150" level="10">
        <if_sid>100100</if_sid>
        <url>script|%3Cscript|%3cscript</url>
        <description>Nginx-XSS: Script tag pattern detected in URI (T1059.007)</description>
        <mitre>
            <id>T1059.007</id>
        </mitre>
        <group>xss,nginx_detect,</group>
    </rule>

    <!-- XSS — URI에 이벤트 핸들러 -->
    <rule id="100151" level="10">
        <if_sid>100100</if_sid>
        <url>onerror=|onload=|ontoggle=|onmouseover=</url>
        <description>Nginx-XSS: Event handler attribute in URI (T1059.007)</description>
        <mitre>
            <id>T1059.007</id>
        </mitre>
        <group>xss,nginx_detect,</group>
    </rule>

    <!-- XSS — javascript: 프로토콜 -->
    <rule id="100152" level="10">
        <if_sid>100100</if_sid>
        <url>javascript:|javascript%3A</url>
        <description>Nginx-XSS: javascript: protocol detected in URI (T1059.007)</description>
        <mitre>
            <id>T1059.007</id>
        </mitre>
        <group>xss,nginx_detect,</group>
    </rule>

    <!-- XSS — alert()/document.cookie -->
    <rule id="100153" level="12">
        <if_sid>100100</if_sid>
        <url>alert(|document.cookie|document.domain</url>
        <description>Nginx-XSS: JS function/cookie access pattern in URI (T1059.007)</description>
        <mitre>
            <id>T1059.007</id>
        </mitre>
        <group>xss,data_exfiltration,nginx_detect,</group>
    </rule>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- Nginx 보조: SSRF 탐지 (100160–100169)                              -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <!-- SSRF — 메타데이터/내부 IP -->
    <rule id="100160" level="12">
        <if_sid>100100</if_sid>
        <url>169.254.169.254|127.0.0.1|localhost|metadata.google.internal</url>
        <description>Nginx-SSRF: Internal/metadata endpoint in URI (T1090)</description>
        <mitre>
            <id>T1090</id>
        </mitre>
        <group>ssrf,nginx_detect,</group>
    </rule>

    <!-- SSRF — IP 인코딩 우회 -->
    <rule id="100161" level="12">
        <if_sid>100100</if_sid>
        <url>0x7f|2130706433|0177.0</url>
        <description>Nginx-SSRF: Encoded IP bypass attempt in URI (T1090)</description>
        <mitre>
            <id>T1090</id>
        </mitre>
        <group>ssrf,evasion,nginx_detect,</group>
    </rule>

    <!-- SSRF — preview 엔드포인트로 외부 fetch -->
    <rule id="100162" level="10">
        <if_sid>100100</if_sid>
        <url>/api/preview</url>
        <description>Nginx-SSRF: URL preview endpoint accessed (T1090)</description>
        <mitre>
            <id>T1090</id>
        </mitre>
        <group>ssrf,nginx_detect,</group>
    </rule>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- Nginx 보조: RCE / Command Injection 탐지 (100170–100179)           -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <!-- CMDi — ping 엔드포인트 + 메타문자 -->
    <rule id="100170" level="12">
        <if_sid>100100</if_sid>
        <url>/api/admin/ping</url>
        <description>Nginx-CMDi: Admin ping endpoint accessed (T1059.004)</description>
        <mitre>
            <id>T1059.004</id>
        </mitre>
        <group>command_injection,nginx_detect,</group>
    </rule>

    <!-- CMDi — sleep 명령 (blind) -->
    <rule id="100171" level="12">
        <if_sid>100170</if_sid>
        <url>sleep|%24%28sleep</url>
        <description>Nginx-CMDi: Blind command injection (sleep) detected (T1059.004)</description>
        <mitre>
            <id>T1059.004</id>
        </mitre>
        <group>command_injection,blind_cmdi,nginx_detect,</group>
    </rule>

    <!-- CMDi — 쉘 메타문자 (;, |, &&) -->
    <rule id="100172" level="12">
        <if_sid>100170</if_sid>
        <url>%3B|%7C|%26%26|%60|%24%28</url>
        <description>Nginx-CMDi: Shell metacharacter in ping request (T1059.004)</description>
        <mitre>
            <id>T1059.004</id>
        </mitre>
        <group>command_injection,rce,nginx_detect,</group>
    </rule>

    <!-- CMDi — /etc/passwd, whoami -->
    <rule id="100173" level="14">
        <if_sid>100170</if_sid>
        <url>etc%2Fpasswd|etc%2Fshadow|whoami</url>
        <description>Nginx-CMDi: System file/identity command in ping request (T1059.004)</description>
        <mitre>
            <id>T1059.004</id>
        </mitre>
        <group>command_injection,sensitive_data,nginx_detect,</group>
    </rule>

    <!-- CMDi — $IFS, newline 우회 -->
    <rule id="100174" level="12">
