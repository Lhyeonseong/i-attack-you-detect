COMPOSE_PROJECT_NAME=security-lab

# Versions
WAZUH_VERSION=4.14.9
POSTGRES_VERSION=16.15-trixie

# Published ports
CALDERA_WEB_PORT=8888
CALDERA_CONTACT_HTTP_PORT=7010
CALDERA_CONTACT_UDP_PORT=7011
CALDERA_CONTACT_TCP_PORT=7012
TARGET_HTTP_PORT=8080
INDEXER_PORT=9200
WAZUH_AGENT_EVENTS_PORT=1514
WAZUH_AGENT_REGISTRATION_PORT=1515
WAZUH_SYSLOG_PORT=514
WAZUH_API_PORT=55000
POSTGRES_PORT=5432

# Wazuh / OpenSearch
INDEXER_USERNAME=admin
INDEXER_PASSWORD=__GENERATE_WITH_openssl_rand_base64_24__
WAZUH_API_USERNAME=wazuh-wui
WAZUH_API_PASSWORD=__GENERATE__
INDEXER_HEAP=1g

# PostgreSQL
POSTGRES_DB=vulndb
POSTGRES_USER=vulnuser
# POSTGRES_USER 는 superuser — DB 관리자 전용 (부트스트랩 SQL 실행용). 앱은 vuln_app 으로 접속
POSTGRES_PASSWORD=__GENERATE__
# 취약 앱 non-superuser role vuln_app (db/bootstrap/app_role.sql -v apppw=...)
VULN_APP_DB_PASSWORD=__GENERATE__

# Target webapp
TARGET_JWT_SECRET=__GENERATE__

# S3 correlation — Caldera red API key (Caldera 컨테이너 /usr/src/app/conf/local.yml 의 api_key_red)
# URL·계정명은 docker-compose.yml 에 고정
APP_CALDERA_APIKEY=__FROM_CALDERA_CONF__

# Caldera 비밀값 고정 — config/caldera/entrypoint.sh 가 local.yml.template 에 치환 (재생성해도 유지)
# APP_CALDERA_APIKEY 는 CALDERA_API_KEY_RED 와 같은 값이어야 한다
CALDERA_API_KEY_RED=replace_me
CALDERA_API_KEY_BLUE=replace_me
CALDERA_CRYPT_SALT=replace_me
CALDERA_ENCRYPTION_KEY=replace_me

# S3 validation schema role validation_rw (db/bootstrap/validation_role.sql -v valpw=...)
VALIDATION_DB_PASSWORD=__GENERATE__
# S4-6 validation-api 읽기 전용 role validation_ro (db/bootstrap/validation_ro_role.sql -v ropw=...)
VALIDATION_RO_PASSWORD=__GENERATE_WITH_openssl_rand_base64_24__
# S4-6 validation-api Bearer 토큰(smoke·capture, 쉼표 구분) — /tmp/s4-6-secrets.sh 가 생성
VALIDATION_API_BEARER_TOKENS=__GENERATE__
# S4-6 대시보드 로그인(비밀번호는 bcrypt 해시만 저장, 작은따옴표로 감쌀 것)
VALIDATION_UI_USERNAME=viewer
VALIDATION_UI_PASSWORD_BCRYPT='__BCRYPT_HASH__'
