{
  "name": "validation-dashboard-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "검증 대시보드 프런트엔드 (ATT&CK Validator) — v8 HTML 이식",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
